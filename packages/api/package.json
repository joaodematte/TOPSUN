{
  "name": "@topsun/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./trpc": {
      "default": "./src/trpc/router.ts"
    },
    "./trpc/context": {
      "default": "./src/trpc/context.ts"
    },
    "./features/request-protocol/schema": {
      "default": "./src/features/request-protocol/schema.ts"
    },
    "./features/inspection-approval/schema": {
      "default": "./src/features/inspection-approval/schema.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.7.0",
    "@topsun/db": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@topsun/config": "workspace:*",
    "hono": "catalog:",
    "typescript": "catalog:"
  }
}
