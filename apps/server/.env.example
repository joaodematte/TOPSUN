# Server
PORT=3001
HOSTNAME=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/topsun
TOPSUN_DATABASE_URL=mysql://user:password@localhost:3306/topsun

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Playwright / automation (Docker defaults shown)
CHROME_PATH=/usr/bin/chromium
AUTOMATION_HEADLESS=true
AUTOMATION_OUTPUT_DIR=/app/automation-runs

# TOPSUN automation
TOPSUN_USERNAME=
TOPSUN_PASSWORD=
TOPSUN_ETAPAS_PAGE=
TOPSUN_CONCURRENCY=3
REQUEST_PROTOCOL_URL=

# Designer form fields (request protocol)
DESIGNER_NAME=
DESIGNER_CPF=
DESIGNER_EMAIL=
DESIGNER_PHONE=

# Gmail (validate protocol return)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# CELESC (verify/approve request access)
CELESC_LUIZ_EMAIL=
CELESC_LUIZ_PASSWORD=
CELESC_GABRIEL_EMAIL=
CELESC_GABRIEL_PASSWORD=
# Minimum interval between CELESC GraphQL requests in ms (default: 1000)
CELESC_REQUEST_INTERVAL_MS=1000
